# ==========================================
# AI Cockpit PME - Configuration
# ==========================================

# 1. Clé d'API IA (Google Gemini / OpenAI / Anthropic)
# Si cette clé est absente, l'application bascule automatiquement
# sur le mode simulateur local sécurisé (Mock Mode) pour la démo.
GOOGLE_API_KEY=your_gemini_api_key_here

# 2. Supabase (Optionnel pour la démo - un stockage local résilient est actif par défaut)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
